# Copy to .env for local overrides, or set these in your host's environment settings.
# Never commit real values. Everything is optional locally.

# Required on Vercel and Cloud Run (the server refuses to start without it).
# Generate one with: openssl rand -hex 32
# SESSION_SECRET=

# Data store: memory (default), redis or firestore.
# Redis is picked automatically when these are present (set by the Upstash Vercel integration):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STORE=memory
# Public demo only: wipes ALL data, including submitted reports, once per IST day (Redis).
# DEMO_DAILY_RESET=false

# Gemini for voice reports and triage. Either an AI Studio key...
# GEMINI_API_KEY=
# ...or Vertex AI through a Google Cloud project:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-3.8-flash
